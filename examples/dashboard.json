{
  "name": "system-dashboard",
  "version": "0.1.0",
  "keybindings": {
    "1": "focus-next",
    "0": "focus-prev"
  },
  "layout": {
    "direction": "row",
    "children": [
      {
        "size": "28",
        "pane": {
          "type": "text",
          "title": "nav",
          "content": "ULTIMATE TUI\n\n- overview\n- processes\n- disk\n- kernel\n\narrows / tab  focus\nenter / esc   lock / release\nF1           help\nalt+q        quit"
        }
      },
      {
        "size": "*",
        "direction": "column",
        "children": [
          {
            "size": "40%",
            "direction": "row",
            "children": [
              { "size": "50%", "pane": { "type": "command", "title": "host",   "command": "uname -sr; uptime" } },
              { "size": "*",   "pane": { "type": "command", "title": "disk",   "command": "df -h / /home 2>/dev/null | cat" } }
            ]
          },
          {
            "size": "*",
            "pane": {
              "type": "command",
              "title": "processes (top by rss)",
              "command": "ps -eo pid,rss,comm --sort=-rss | head -n 20"
            }
          }
        ]
      }
    ]
  }
}
