{
  "name": "system-dashboard",
  "version": "0.1.0",
  "keybindings": {
    "0": "focus-prev",
    "1": "focus-next"
  },
  "layout": {
    "children": [
      {
        "size": "7%",
        "pane": {
          "type": "shell",
          "title": "cava",
          "border": false,
          "content": "ULTIMATE TUI\n\n- overview\n- processes\n- disk\n- kernel\n\narrows / tab  focus\nenter / esc   lock / release\nF1           help\nF3           theme \u0026 style\nCtrl+C       quit",
          "command": "cava"
        }
      },
      {
        "size": "93%",
        "pane": {
          "type": "shell",
          "title": "New pane",
          "border": true,
          "command": "btop"
        }
      }
    ]
  }
}
