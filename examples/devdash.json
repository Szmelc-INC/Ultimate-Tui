{
  "name": "devdash",
  "version": "0.1.0",
  "keybindings": {
    "mod+j": "focus-next",
    "mod+k": "focus-prev",
    "mod+l": "focus-next"
  },
  "layout": {
    "direction": "row",
    "children": [
      {
        "size": "35%",
        "children": [
          {
            "size": "23%",
            "pane": {
              "type": "shell",
              "title": " git status",
              "border": true,
              "command": "hsh"
            }
          },
          {
            "size": "77%",
            "direction": "row",
            "children": [
              {
                "size": "43%",
                "pane": {
                  "type": "command",
                  "title": " git log  --graph",
                  "border": true,
                  "command": "git -c color.ui=always log --graph --abbrev-commit --decorate --format='%C(auto)%h%d %s %C(dim)%cr %an%C(reset)' -20 2\u003e\u00261 | cat"
                }
              },
              {
                "size": "57%",
                "pane": {
                  "type": "shell",
                  "title": "New pane",
                  "border": true,
                  "command": "tree / | lolcat -a -s 77 -p 1000 -F 0.01"
                }
              }
            ]
          }
        ]
      },
      {
        "size": "65%",
        "children": [
          {
            "size": "39%",
            "pane": {
              "type": "command",
              "title": " TODO / FIXME",
              "command": "{ grep -rniE 'TODO|FIXME|XXX|HACK' --include='*.go' . || echo 'clean — no TODO/FIXME markers in *.go'; } | sed 's#^\\./##' | head -n 30"
            }
          },
          {
            "size": "61%",
            "direction": "row",
            "children": [
              {
                "size": "80%",
                "pane": {
                  "type": "shell",
                  "title": " cdvd",
                  "border": true,
                  "command": "cdvd",
                  "shell": "zsh"
                }
              },
              {
                "size": "20%",
                "pane": {
                  "type": "command",
                  "title": " source tree",
                  "border": true,
                  "command": "eza -T -L 2 --icons=always --color=always --group-directories-first . 2\u003e/dev/null | grep . || tree -L 2 -I 'bin' --noreport 2\u003e/dev/null || find . -maxdepth 2 -not -path '*/.git/*' | sort"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
